{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "publicURL": {
      "type": "string",
      "pattern": "^https?://[^/]+/?$"
    },
    "agentControlURL": {
      "type": "string",
      "pattern": "^$|^https?://[^/]+/?$"
    },
    "cookieSecure": {
      "type": "boolean"
    },
    "maintenance": {
      "type": "boolean"
    },
    "existingConfigSecret": {
      "type": "string"
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "web": {
      "type": "object",
      "properties": {
        "replicaCount": {
          "const": 1
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "bootstrap": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingSecret": {
          "type": "string"
        },
        "passwordKey": {
          "type": "string"
        }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "existingClaim": {
          "type": "string"
        },
        "size": {
          "type": "string"
        },
        "storageClass": {
          "type": "string"
        },
        "keep": {
          "type": "boolean"
        },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "enum": [
              "ReadWriteOnce",
              "ReadWriteMany"
            ]
          }
        }
      }
    },
    "server": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "transport": {
          "enum": [
            "http",
            "https",
            "mtls"
          ]
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^$|^sha256:[a-f0-9]{64}$"
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "existingTokenSecret": {
          "type": "string"
        },
        "tokenKey": {
          "type": "string"
        },
        "externalURL": {
          "type": "string",
          "pattern": "^$|^https?://[^/]+/?$"
        },
        "service": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "nodePort": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 65535
            }
          }
        }
      }
    },
    "scheduler": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "operations": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "mysql": {
          "type": "object",
          "properties": {
            "enable": {
              "enum": [
                0,
                1
              ]
            },
            "mysql_port": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "pgsql": {
          "type": "object",
          "properties": {
            "enable": {
              "enum": [
                0,
                1
              ]
            },
            "port": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "host": {
          "type": "string"
        },
        "tls": {
          "type": "array"
        }
      }
    },
    "extraEnv": {
      "type": "array"
    },
    "extraVolumes": {
      "type": "array"
    },
    "extraVolumeMounts": {
      "type": "array"
    }
  }
}
